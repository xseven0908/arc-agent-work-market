{
  "name": "arc-agent-work-market",
  "version": "0.7.0",
  "private": true,
  "description": "Proof-backed AI agent jobs and reputation on Arc Testnet",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "wallets:create:testnet": "node --import tsx src/scripts/create-testnet-wallets.ts",
    "wallets:check:testnet": "node --env-file=.env --import tsx src/scripts/check-testnet-wallets.ts",
    "index:testnet": "node --env-file-if-exists=.env --import tsx src/scripts/index-testnet.ts",
    "demo:testnet": "node --env-file-if-exists=.env --import tsx src/scripts/testnet-workflow.ts",
    "evidence:verify": "node --env-file-if-exists=.env --import tsx src/scripts/verify-evidence.ts"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "viem": "^2.37.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
